<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.trackpay.upilauncher" >

    <uses-sdk android:minSdkVersion="24" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <data
                android:host="pay"
                android:scheme="upi" />
        </intent>
    </queries>

    <application />

</manifest>